// Title: Graph Using Adjacency List and Breadth First Search (BFS) Traversal

#include <iostream>
#include <vector>
#include <queue>
using namespace std;

#define MAX 10

vector<int> graph[MAX];   // adjacency list
bool visited[MAX];        // to keep track of visited vertices
int n;                    // number of vertices

// Add an undirected edge between u and v
void addEdge(int u, int v) {
    graph[u].push_back(v);
    graph[v].push_back(u);
}

// Display the adjacency list
void displayList() {
    cout << "Adjacency List:" << endl;
    for (int i = 0; i < n; i++) {
        cout << i << " -> ";
        for (int j = 0; j < graph[i].size(); j++) {
            cout << graph[i][j] << " ";
        }
        cout << endl;
    }
}

// Breadth First Search using queue
void bfs(int source) {
    queue<int> q;

    visited[source] = true;
    q.push(source);

    while (!q.empty()) {
        int vertex = q.front();
        q.pop();
        cout << vertex << " ";

        // visit all unvisited neighbours
        for (int i = 0; i < graph[vertex].size(); i++) {
            int neighbour = graph[vertex][i];
            if (!visited[neighbour]) {
                visited[neighbour] = true;
                q.push(neighbour);
            }
        }
    }
}

int main() {
    n = 6;

    // Graph:
    //     0 --- 1 --- 3
    //     |     |
    //     2     4 --- 5
    addEdge(0, 1);
    addEdge(0, 2);
    addEdge(1, 3);
    addEdge(1, 4);
    addEdge(4, 5);

    displayList();

    int source = 0;
    cout << endl << "BFS Traversal starting from vertex " << source << ": ";
    bfs(source);
    cout << endl;

    return 0;
}
