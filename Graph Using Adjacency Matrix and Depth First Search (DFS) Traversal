// Title: Graph Using Adjacency Matrix and Depth First Search (DFS) Traversal

#include <iostream>
using namespace std;

#define MAX 10

int graph[MAX][MAX];   // adjacency matrix
bool visited[MAX];     // to keep track of visited vertices
int n;                 // number of vertices

// Add an undirected edge between u and v
void addEdge(int u, int v) {
    graph[u][v] = 1;
    graph[v][u] = 1;
}

// Display the adjacency matrix
void displayMatrix() {
    cout << "Adjacency Matrix:" << endl;
    cout << "  ";
    for (int i = 0; i < n; i++)
        cout << i << " ";
    cout << endl;

    for (int i = 0; i < n; i++) {
        cout << i << " ";
        for (int j = 0; j < n; j++) {
            cout << graph[i][j] << " ";
        }
        cout << endl;
    }
}

// Depth First Search (recursive)
void dfs(int vertex) {
    visited[vertex] = true;
    cout << vertex << " ";

    for (int i = 0; i < n; i++) {
        if (graph[vertex][i] == 1 && !visited[i]) {
            dfs(i);
        }
    }
}

int main() {
    n = 6;

    // Graph:
    //     0 --- 1 --- 3
    //     |     |
    //     2     4 --- 5
    addEdge(0, 1);
    addEdge(0, 2);
    addEdge(1, 3);
    addEdge(1, 4);
    addEdge(4, 5);

    displayMatrix();

    int source = 0;
    cout << endl << "DFS Traversal starting from vertex " << source << ": ";
    dfs(source);
    cout << endl;

    return 0;
}
